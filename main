-- Full standalone ESP for Operation One (custom avatar compatible)
-- Toggle with GUI button.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local espEnabled = true

-- GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ESP_Toggle"
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 40)
frame.Position = UDim2.new(0, 10, 0, 10)
frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 1
frame.BorderColor3 = Color3.new(1, 1, 1)
frame.Parent = screenGui

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(1, -10, 1, -10)
toggle.Position = UDim2.new(0, 5, 0, 5)
toggle.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
toggle.Text = "ESP ON"
toggle.TextColor3 = Color3.new(1, 1, 1)
toggle.TextScaled = true
toggle.Font = Enum.Font.SourceSansBold
toggle.BorderSizePixel = 0
toggle.Parent = frame

local espData = {}

local function getBoundingBox(char)
    local parts = {}
    for _, child in ipairs(char:GetDescendants()) do
        if child:IsA("BasePart") then
            local n = child.Name:lower()
            if not n:match("handle") and not n:match("attach") and not n:match("effect") then
                table.insert(parts, child)
            end
        end
    end
    if #parts == 0 then return nil end

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    for _, p in ipairs(parts) do
        local pos = p.Position
        local half = p.Size / 2
        minX = math.min(minX, pos.X - half.X)
        minY = math.min(minY, pos.Y - half.Y)
        minZ = math.min(minZ, pos.Z - half.Z)
        maxX = math.max(maxX, pos.X + half.X)
        maxY = math.max(maxY, pos.Y + half.Y)
        maxZ = math.max(maxZ, pos.Z + half.Z)
    end
    return Vector3.new((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2),
           Vector3.new(maxX-minX, maxY-minY, maxZ-minZ)
end

local function createESP(name)
    if espData[name] then return end
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.new(1, 0, 0)
    box.Thickness = 2
    box.Filled = false
    local text = Drawing.new("Text")
    text.Visible = false
    text.Color = Color3.new(1, 1, 1)
    text.Size = 14
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.new(0, 0, 0)
    espData[name] = {box = box, text = text}
end

local function removeESP(name)
    local d = espData[name]
    if d then
        if d.box then d.box:Remove() end
        if d.text then d.text:Remove() end
        espData[name] = nil
    end
end

local function updateESP()
    if not espEnabled then
        for _, d in pairs(espData) do
            if d.box then d.box.Visible = false end
            if d.text then d.text.Visible = false end
        end
        return
    end

    for _, other in ipairs(Players:GetPlayers()) do
        if other == player then continue end
        local char = other.Character
        if not char or not char.Parent then
            removeESP(other.Name)
            continue
        end

        if not espData[other.Name] then createESP(other.Name) end
        local d = espData[other.Name]
        if not d then continue end

        local center, size = getBoundingBox(char)
        if not center or not size then
            d.box.Visible = false
            d.text.Visible = false
            continue
        end

        local screenPos, onScreen = camera:WorldToViewportPoint(center)
        if not onScreen then
            d.box.Visible = false
            d.text.Visible = false
            continue
        end

        local dist = (center - camera.CFrame.Position).Magnitude
        local scale = 1 / dist * 100
        local w = math.clamp(size.X * scale * 1.5, 10, 300)
        local h = math.clamp(size.Y * scale * 1.5, 10, 300)
        local x = screenPos.X - w/2
        local y = screenPos.Y - h/2

        d.box.Position = Vector2.new(x, y)
        d.box.Size = Vector2.new(w, h)
        d.box.Visible = true

        d.text.Position = Vector2.new(screenPos.X, y - 15)
        d.text.Text = other.Name .. " [" .. math.floor(dist) .. "m]"
        d.text.Visible = true
    end

    for name in pairs(espData) do
        if not Players:FindFirstChild(name) then
            removeESP(name)
        end
    end
end

toggle.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    toggle.Text = espEnabled and "ESP ON" or "ESP OFF"
    toggle.BackgroundColor3 = espEnabled and Color3.new(0.2, 0.6, 0.2) or Color3.new(0.6, 0.2, 0.2)
end)

RunService.RenderStepped:Connect(updateESP)

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player then
        p.CharacterAdded:Connect(function() task.wait(0.5) createESP(p.Name) end)
        if p.Character then createESP(p.Name) end
    end
end

Players.PlayerRemoving:Connect(removeESP)
player.CharacterAdded:Connect(function() for n in pairs(espData) do removeESP(n) end end)

print("Operation One ESP loaded. Toggle with GUI.")
