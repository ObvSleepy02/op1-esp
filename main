-- Operation One ESP - Custom character detection (no HumanoidRootPart/Head assumed)
-- Scans for any BasePart and uses bounding box based on all parts.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local espEnabled = true

-- GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ESP_Toggle_Gui"
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 40)
frame.Position = UDim2.new(0, 10, 0, 10)
frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 1
frame.BorderColor3 = Color3.new(1, 1, 1)
frame.Parent = screenGui

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(1, -10, 1, -10)
toggleButton.Position = UDim2.new(0, 5, 0, 5)
toggleButton.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
toggleButton.Text = "ESP ON"
toggleButton.TextColor3 = Color3.new(1, 1, 1)
toggleButton.TextScaled = true
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.BorderSizePixel = 0
toggleButton.Parent = frame

local espHolder = Instance.new("Folder")
espHolder.Name = "ESP_Holder"
espHolder.Parent = player.PlayerGui

local espData = {}

-- Get all character parts (ignores accessories, particles, etc.)
local function getCharacterParts(char)
    local parts = {}
    for _, child in ipairs(char:GetDescendants()) do
        if child:IsA("BasePart") then
            -- Filter out common non-body parts (optional)
            local name = child.Name:lower()
            if not name:match("handle") and not name:match("attach") and not name:match("effect") and not name:match("particle") then
                table.insert(parts, child)
            end
        end
    end
    return parts
end

-- Compute bounding box center and size from parts
local function getBoundingBox(char)
    local parts = getCharacterParts(char)
    if #parts == 0 then return nil end

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge

    for _, part in ipairs(parts) do
        local pos = part.Position
        local size = part.Size / 2
        -- Get world corners (approximate)
        local x, y, z = pos.X, pos.Y, pos.Z
        local hx, hy, hz = size.X, size.Y, size.Z
        minX = math.min(minX, x - hx)
        minY = math.min(minY, y - hy)
        minZ = math.min(minZ, z - hz)
        maxX = math.max(maxX, x + hx)
        maxY = math.max(maxY, y + hy)
        maxZ = math.max(maxZ, z + hz)
    end

    local center = Vector3.new((minX + maxX)/2, (minY + maxY)/2, (minZ + maxZ)/2)
    local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
    return center, size
end

local function createESP(targetChar)
    if not targetChar or not targetChar:IsA("Model") then return end
    if espData[targetChar.Name] then return end

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.new(1, 0, 0)
    box.Thickness = 2
    box.Filled = false

    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Color = Color3.new(1, 1, 1)
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.OutlineColor = Color3.new(0, 0, 0)

    espData[targetChar.Name] = {box = box, nameTag = nameTag, lastCenter = nil, lastSize = nil}
end

local function removeESP(playerName)
    local data = espData[playerName]
    if data then
        if data.box then data.box:Remove() end
        if data.nameTag then data.nameTag:Remove() end
        espData[playerName] = nil
    end
end

local function updateESP()
    if not espEnabled then
        for _, data in pairs(espData) do
            if data.box then data.box.Visible = false end
            if data.nameTag then data.nameTag.Visible = false end
        end
        return
    end

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == player then continue end
        local char = otherPlayer.Character
        if not char or not char.Parent then
            removeESP(otherPlayer.Name)
            continue
        end

        if not espData[otherPlayer.Name] then
            createESP(char)
        end

        local data = espData[otherPlayer.Name]
        if not data then continue end
        local box = data.box
        local nameTag = data.nameTag
        if not box or not nameTag then continue end

        local center, size = getBoundingBox(char)
        if not center or not size then
            box.Visible = false
            nameTag.Visible = false
            continue
        end

        -- Convert 3D bounding box to screen
        local centerScreen, onScreen = camera:WorldToViewportPoint(center)
        if not onScreen then
            box.Visible = false
            nameTag.Visible = false
            continue
        end

        -- Estimate screen size from 3D size and distance
        local dist = (center - camera.CFrame.Position).Magnitude
        local scale = 1 / dist * 100  -- rough perspective factor
        local width = size.X * scale * 1.5
        local height = size.Y * scale * 1.5
        width = math.clamp(width, 10, 300)
        height = math.clamp(height, 10, 300)

        local x = centerScreen.X - width/2
        local y = centerScreen.Y - height/2

        box.Position = Vector2.new(x, y)
        box.Size = Vector2.new(width, height)
        box.Visible = true

        nameTag.Position = Vector2.new(centerScreen.X, y - 15)
        nameTag.Text = otherPlayer.Name .. " [" .. math.floor(dist) .. "m]"
        nameTag.Visible = true
    end

    -- Cleanup
    for name, _ in pairs(espData) do
        if not Players:FindFirstChild(name) then
            removeESP(name)
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    toggleButton.Text = espEnabled and "ESP ON" or "ESP OFF"
    toggleButton.BackgroundColor3 = espEnabled and Color3.new(0.2, 0.6, 0.2) or Color3.new(0.6, 0.2, 0.2)
end)

RunService.RenderStepped:Connect(updateESP)

for _, otherPlayer in ipairs(Players:GetPlayers()) do
    if otherPlayer ~= player and otherPlayer.Character then
        createESP(otherPlayer.Character)
    end
end

Players.PlayerAdded:Connect(function(newPlayer)
    newPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        createESP(char)
    end)
end)

Players.PlayerRemoving:Connect(function(playerLeaving)
    removeESP(playerLeaving.Name)
end)

player.CharacterAdded:Connect(function()
    for name, _ in pairs(espData) do
        removeESP(name)
    end
end)

print("ESP loaded - custom bounding box mode. Toggle with GUI.")
