-- ALTERNATIVE: GUI-based ESP (Frames)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local espEnabled = true
local gui = Instance.new("ScreenGui")
gui.Name = "EspGui"
gui.Parent = player:WaitForChild("PlayerGui")

local espFrames = {}

local function createFrame(playerName)
    if espFrames[playerName] then return end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 100, 0, 100)
    frame.Position = UDim2.new(0, 0, 0, 0)
    frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    frame.Visible = false
    frame.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Position = UDim2.new(0, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = frame

    espFrames[playerName] = { frame = frame, label = label }
end

local function removeFrame(playerName)
    local data = espFrames[playerName]
    if data then
        data.frame:Destroy()
        espFrames[playerName] = nil
    end
end

local function updateESP()
    if not espEnabled then
        for _, data in pairs(espData) do
            data.box.Visible = false
            data.label.Visible = false
        end
        return
    end

    local currentPlayers = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            currentPlayers[plr.Name] = true
            local char = plr.Character
            if char and char.Parent then
                if not espData[plr.Name] then
                    createESP(plr.Name)
                end
                local data = espData[plr.Name]
                if data then
                    local parts = getAllParts(char)
                    local center, size = getBoundingBox(parts)
                    if center and size then
                        local screenPos, onScreen = camera:WorldToViewportPoint(center)
                        if onScreen then
                            local dist = (center - camera.CFrame.Position).Magnitude
                            -- ADJUST SIZE: change multiplier (currently 1.8)
                            local scale = 1 / dist * 180
                            local w = math.clamp(size.X * scale, 15, 500)
                            local h = math.clamp(size.Y * scale, 15, 500)
                            -- ADJUST VERTICAL OFFSET: negative moves up (currently -10)
                            local verticalOffset = -10
                            local x = screenPos.X - w / 2
                            local y = screenPos.Y - h / 2 + verticalOffset

                            data.box.Position = Vector2.new(x, y)
                            data.box.Size = Vector2.new(w, h)
                            data.box.Visible = true

                            data.label.Position = Vector2.new(screenPos.X, y - 20)
                            data.label.Text = plr.Name .. " [" .. math.floor(dist) .. "m]"
                            data.label.Visible = true
                        else
                            data.box.Visible = false
                            data.label.Visible = false
                        end
                    else
                        data.box.Visible = false
                        data.label.Visible = false
                    end
                end
            else
                if espData[plr.Name] then
                    espData[plr.Name].box.Visible = false
                    espData[plr.Name].label.Visible = false
                end
            end
        end
    end

    for name in pairs(espData) do
        if not currentPlayers[name] then
            removeESP(name)
        end
    end
end

UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F1 then
        espEnabled = not espEnabled
        print(espEnabled and "GUI ESP ON" or "GUI ESP OFF")
    end
end)

RunService.RenderStepped:Connect(updateESP)
print("GUI ESP LOADED. Press F1 to toggle.")
