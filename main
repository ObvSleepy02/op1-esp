-- Operation One ESP with toggle UI (non-default avatar support)
-- Execute this script. A small GUI will appear. Click "ESP ON/OFF" to toggle.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local espEnabled = true  -- default on

-- Create screen GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ESP_Toggle_Gui"
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 40)
frame.Position = UDim2.new(0, 10, 0, 10)
frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 1
frame.BorderColor3 = Color3.new(1, 1, 1)
frame.Parent = screenGui

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(1, -10, 1, -10)
toggleButton.Position = UDim2.new(0, 5, 0, 5)
toggleButton.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
toggleButton.Text = "ESP ON"
toggleButton.TextColor3 = Color3.new(1, 1, 1)
toggleButton.TextScaled = true
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.BorderSizePixel = 0
toggleButton.Parent = frame

-- ESP storage
local espHolder = Instance.new("Folder")
espHolder.Name = "ESP_Holder"
espHolder.Parent = player.PlayerGui

-- Drawing objects table
local espData = {}  -- key = player.Name, value = {box, nameTag}

local function createESP(targetChar)
    if not targetChar or not targetChar:IsA("Model") then return end
    if espData[targetChar.Name] then return end

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.new(1, 0, 0)
    box.Thickness = 2
    box.Filled = false

    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Color = Color3.new(1, 1, 1)
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.OutlineColor = Color3.new(0, 0, 0)

    espData[targetChar.Name] = {box = box, nameTag = nameTag}
end

local function removeESP(playerName)
    local data = espData[playerName]
    if data then
        if data.box then data.box:Remove() end
        if data.nameTag then data.nameTag:Remove() end
        espData[playerName] = nil
    end
end

local function updateESP()
    if not espEnabled then
        -- Hide all
        for _, data in pairs(espData) do
            if data.box then data.box.Visible = false end
            if data.nameTag then data.nameTag.Visible = false end
        end
        return
    end

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == player then continue end
        local char = otherPlayer.Character
        if not char or not char.Parent then
            removeESP(otherPlayer.Name)
            continue
        end

        if not espData[otherPlayer.Name] then
            createESP(char)
        end

        local data = espData[otherPlayer.Name]
        if not data then continue end
        local box = data.box
        local nameTag = data.nameTag
        if not box or not nameTag then continue end

        -- Find primary part (HumanoidRootPart or custom)
        local primaryPart = char:FindFirstChild("HumanoidRootPart")
        if not primaryPart then
            local parts = char:GetDescendants()
            for _, part in ipairs(parts) do
                if part:IsA("BasePart") and part:GetAttribute("Primary") == true then
                    primaryPart = part
                    break
                end
            end
            if not primaryPart then
                local maxVol = 0
                for _, part in ipairs(parts) do
                    if part:IsA("BasePart") then
                        local vol = part.Size.X * part.Size.Y * part.Size.Z
                        if vol > maxVol then
                            maxVol = vol
                            primaryPart = part
                        end
                    end
                end
            end
        end

        if not primaryPart then
            box.Visible = false
            nameTag.Visible = false
            continue
        end

        local head = char:FindFirstChild("Head")
        if not head then
            local highestY = -math.huge
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Position.Y > highestY then
                    highestY = part.Position.Y
                    head = part
                end
            end
        end

        if not head then
            box.Visible = false
            nameTag.Visible = false
            continue
        end

        local primaryPos, onScreen1 = camera:WorldToViewportPoint(primaryPart.Position)
        local headPos, onScreen2 = camera:WorldToViewportPoint(head.Position)
        if not onScreen1 or not onScreen2 then
            box.Visible = false
            nameTag.Visible = false
            continue
        end

        local dist = (primaryPart.Position - camera.CFrame.Position).Magnitude
        local width = math.clamp(200 / dist * 2, 20, 150)
        local height = math.abs(headPos.Y - primaryPos.Y) + 20
        if headPos.Y > primaryPos.Y then
            height = math.abs(headPos.Y - primaryPos.Y) + 10
        else
            height = math.abs(primaryPos.Y - headPos.Y) + 30
        end

        local x = primaryPos.X - width/2
        local y = headPos.Y - height/2

        box.Position = Vector2.new(x, y)
        box.Size = Vector2.new(width, height)
        box.Visible = true

        nameTag.Position = Vector2.new(primaryPos.X, y - 15)
        nameTag.Text = otherPlayer.Name .. " [" .. math.floor(dist) .. "m]"
        nameTag.Visible = true
    end

    -- Cleanup for players that left
    for name, _ in pairs(espData) do
        if not Players:FindFirstChild(name) then
            removeESP(name)
        end
    end
end

-- Toggle function
toggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    toggleButton.Text = espEnabled and "ESP ON" or "ESP OFF"
    toggleButton.BackgroundColor3 = espEnabled and Color3.new(0.2, 0.6, 0.2) or Color3.new(0.6, 0.2, 0.2)
end)

-- Connect to render loop
RunService.RenderStepped:Connect(updateESP)

-- Initial setup
for _, otherPlayer in ipairs(Players:GetPlayers()) do
    if otherPlayer ~= player and otherPlayer.Character then
        createESP(otherPlayer.Character)
    end
end

Players.PlayerAdded:Connect(function(newPlayer)
    newPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        createESP(char)
    end)
end)

Players.PlayerRemoving:Connect(function(playerLeaving)
    removeESP(playerLeaving.Name)
end)

player.CharacterAdded:Connect(function()
    for name, _ in pairs(espData) do
        removeESP(name)
    end
end)

print("ESP loaded. Toggle with GUI button.")
