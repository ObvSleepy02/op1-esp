-- ALTERNATIVE: GUI-based ESP (Frames)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local espEnabled = true
local gui = Instance.new("ScreenGui")
gui.Name = "EspGui"
gui.Parent = player:WaitForChild("PlayerGui")

local espFrames = {}

local function createFrame(playerName)
    if espFrames[playerName] then return end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 100, 0, 100)
    frame.Position = UDim2.new(0, 0, 0, 0)
    frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    frame.Visible = false
    frame.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Position = UDim2.new(0, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = frame

    espFrames[playerName] = { frame = frame, label = label }
end

local function removeFrame(playerName)
    local data = espFrames[playerName]
    if data then
        data.frame:Destroy()
        espFrames[playerName] = nil
    end
end

local function updateESP()
    if not espEnabled then
        for _, data in pairs(espFrames) do
            data.frame.Visible = false
        end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char or not char.Parent then
            if espFrames[plr.Name] then
                espFrames[plr.Name].frame.Visible = false
            end
            continue
        end

        if not espFrames[plr.Name] then
            createFrame(plr.Name)
        end
        local data = espFrames[plr.Name]
        if not data then continue end

        -- Find any part to get position
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
        if not root then
            -- search for any BasePart
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") then
                    root = obj
                    break
                end
            end
        end
        if not root then
            data.frame.Visible = false
            continue
        end

        local pos, onScreen = camera:WorldToViewportPoint(root.Position)
        if not onScreen then
            data.frame.Visible = false
            continue
        end

        local dist = (root.Position - camera.CFrame.Position).Magnitude
        local size = math.clamp(300 / dist * 2, 20, 150)

        data.frame.Position = UDim2.new(0, pos.X - size/2, 0, pos.Y - size/2)
        data.frame.Size = UDim2.new(0, size, 0, size)
        data.frame.Visible = true
        data.label.Text = plr.Name .. " [" .. math.floor(dist) .. "m]"
    end

    -- cleanup
    for name in pairs(espFrames) do
        if not Players:FindFirstChild(name) then
            removeFrame(name)
        end
    end
end

UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F1 then
        espEnabled = not espEnabled
        print(espEnabled and "GUI ESP ON" or "GUI ESP OFF")
    end
end)

RunService.RenderStepped:Connect(updateESP)
print("GUI ESP LOADED. Press F1 to toggle.")
